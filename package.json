{
  "name": "dsh-safe-delete-tool",
  "version": "2.0.3",
  "description": "Recoverable, workspace-jailed file deletion for DeepSeek Harness: a per-item trash behind delete_file / restore_file / list_trash, plus a small schema-shaped guard for shells and run_code in every agent preset.",
  "author": "chenqianyu486 <chenqianyu486@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenqianyu486-sys/dsh-save-delete-tool.git"
  },
  "homepage": "https://github.com/chenqianyu486-sys/dsh-save-delete-tool#readme",
  "bugs": {
    "url": "https://github.com/chenqianyu486-sys/dsh-save-delete-tool/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "safe-delete",
    "trash",
    "recoverable",
    "rm",
    "file-deletion",
    "agent-safety"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.3",
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
